# Números de teléfono del estudio
NEXT_PUBLIC_PHONE_1=666849365
NEXT_PUBLIC_PHONE_2=690639894

# Access key de Web3Forms, que recibe el formulario de contacto y lo reenvía
# por email. Se saca en https://web3forms.com dando el email de destino.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: la página de contacto se pre-renderiza
# en el build, así que basta con que exista en tiempo de compilación.
#
# Si falta, la página de contacto no pinta el formulario: muestra email y
# WhatsApp en su lugar, para no perder el contacto en silencio. Al ser export
# estático se resuelve en el build, así que hay que definirla también en Vercel
# y volver a desplegar para que surta efecto.
WEB3FORMS_ACCESS_KEY=
