{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.syxestudio.es" }],
      "destination": "https://syxestudio.es/:path*",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/caracteristicas/",
      "permanent": true
    },
    {
      "source": "/servicios/",
      "destination": "/caracteristicas/",
      "permanent": true
    }
  ]
}
